{
  "name": "tempo-color",
  "version": "1.0.5",
  "scripts": {
    "dev": "concurrently \"npm:dev:web\" \"npm:api\"",
    "dev:web": "vite",
    "api": "node server/index.mjs",
    "start": "node app.js",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run deploy:prod",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "deploy:pages": "gh-pages -d dist --add",
    "db:setup": "node scripts/setup-mysql.mjs"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mysql2": "^3.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "gh-pages": "^6.3.0",
    "ssh2": "^1.17.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.3"
  }
}
